    "next": "^16.0.0",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.3.6"
