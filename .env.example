# Copy to .env.local. Never commit credentials. Runtime: Node 22+.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public catalog fixtures only. Ignored in production and when Supabase is configured.
DEMO_MODE=false

# Mercado Pago Checkout Pro. All credentials below are SERVER ONLY.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_LIVE_MODE=false
# Long random secret (at least 24 characters) for scheduled reconciliation.
CRON_SECRET=

# Cloudflare Stream. API token scoped to Stream Edit for this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Comma-separated domain hostnames, without protocol. Set production and preview hosts.
CLOUDFLARE_ALLOWED_ORIGINS=localhost
